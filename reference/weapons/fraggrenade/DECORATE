//Alternative Fire
ACTOR D3Grenade2 : D3Grenade1	//Throw a Grenade at full speed that won't bounce as much.
{	
	Speed 30
	BounceCount 3
}

Actor FragGrenadeAmmo : Ammo 11908	// use this instead of the weapon as DropItem
{
	//$Category Ammunition
	//$Title "Frag Grenade"
	Inventory.Amount 1
	Inventory.MaxAmount 40
	ammo.backpackamount 1
	ammo.backpackmaxamount 80
	+INVENTORY.IGNORESKILL
	Inventory.PickupMessage "you shouldn't ever see this message because this item will be replaced by the actual weapon"
	Inventory.Icon "GNA1A0"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_SpawnItemEx("FragGrenade")
		Stop
	}
}

Actor FragGrenadeBox : CustomInventory 11909
{
	//$Category Ammunition
	//$Title "Box of Grenades"
	Scale 0.7
	Inventory.PickupSound "misc/i_pkup"
	Inventory.PickupMessage "Picked up a box of Frag Grenades."
	States
	{
	Spawn:
		GNBX A -1
		Stop
	Pickup:
		TNT1 A 0 A_GiveInventory("FragGrenade")
		TNT1 A 0 A_GiveInventory("FragGrenadeAmmo",4)
		Stop
	}
}